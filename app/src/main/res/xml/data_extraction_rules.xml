<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="parent-auth.xml" />
        <exclude domain="sharedpref" path="youtube-debug-session.xml" />
        <exclude domain="file" path="device-tokens.json" />
        <exclude domain="file" path="idempotency.json" />
        <exclude domain="file" path="youtube-cookies.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="parent-auth.xml" />
        <exclude domain="sharedpref" path="youtube-debug-session.xml" />
        <exclude domain="file" path="device-tokens.json" />
        <exclude domain="file" path="idempotency.json" />
        <exclude domain="file" path="youtube-cookies.txt" />
    </device-transfer>
</data-extraction-rules>
