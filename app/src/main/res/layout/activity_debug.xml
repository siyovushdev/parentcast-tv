<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101418"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/debug_title"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/debug_warning"
            android:textColor="#FDD663"
            android:textSize="18sp" />

        <TextView android:id="@+id/modeStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#FDD663" android:textSize="18sp" />
        <CheckBox android:id="@+id/autoResumeAfterBoot" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Автопродолжение сохранённого PLAY при запуске"
            android:textColor="#FFFFFF" />
        <Button android:id="@+id/selectHomeButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Выбрать ParentCast как HOME" />
        <Button android:id="@+id/childModeButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Включить детский просмотр" />
        <Button android:id="@+id/privilegedTrialButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Проверить системный kiosk — один сеанс"
            android:visibility="gone" />
        <Button android:id="@+id/restoreLauncherButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Вернуть штатный Launcher и отключить HOME" />

        <TextView
            android:id="@+id/panelStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/debug_panel_title"
            android:textColor="#8AB4F8"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/pinInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/debug_pin_hint"
            android:importantForAutofill="no"
            android:inputType="numberPassword"
            android:maxLength="12"
            android:textColor="#FFFFFF"
            android:textColorHint="#9AA0A6"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/newPinInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/debug_new_pin_hint"
            android:importantForAutofill="no"
            android:inputType="numberPassword"
            android:maxLength="12"
            android:textColor="#FFFFFF"
            android:textColorHint="#9AA0A6"
            android:textSize="18sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/savePinButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/debug_save_pin" />

        <Button
            android:id="@+id/pairButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/debug_pair"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pairStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/debug_pair_status"
            android:textColor="#FDD663"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/debug_devices"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/devicesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <EditText
            android:id="@+id/linkInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/debug_link_hint"
            android:inputType="textUri"
            android:maxLines="1"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#9AA0A6"
            android:textSize="18sp" />

        <Button
            android:id="@+id/addButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/debug_add" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/playButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/debug_play" />

            <Button
                android:id="@+id/pauseButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/debug_pause" />

            <Button
                android:id="@+id/nextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/debug_next" />

            <Button
                android:id="@+id/stopButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/debug_stop" />
        </LinearLayout>

        <TextView
            android:id="@+id/sessionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/debug_session_disabled"
            android:textColor="#FDD663"
            android:textSize="16sp" />

        <Button
            android:id="@+id/importSessionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/debug_session_import" />

        <Button
            android:id="@+id/disableSessionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/debug_session_disable" />

        <TextView
            android:id="@+id/debugStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#E8EAED"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/storageWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/debug_storage_warning"
            android:textColor="#FDD663"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/currentItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/diagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#9AA0A6"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/debug_queue"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/queueContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/debug_legal"
            android:textColor="#9AA0A6"
            android:textSize="14sp" />

        <Button
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/debug_back" />
    </LinearLayout>
</ScrollView>
